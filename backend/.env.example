# ZoodSle - Local Configuration Template
# Base URL of your local LM Studio instance (default is http://127.0.0.1:1234/v1)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# The identifier of the vision-language model loaded in LM Studio
# Example: qwen/qwen3-vl-4b
LM_STUDIO_MODEL=qwen/qwen3-vl-4b

# Maximum allowed image upload size in megabytes (default: 10)
MAX_UPLOAD_MB=10

# Optional API key if you enabled authentication in LM Studio (leave empty for local default)
LM_STUDIO_API_KEY=

# Port and host for the backend server
PORT=8000
HOST=127.0.0.1
